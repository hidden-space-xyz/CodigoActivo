{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "CodigoActivo": "Information",
      "Program": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "CodigoActivo.API.Middlewares.RequestLoggingMiddleware": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "MaxSizeBytes": 10485760
  },
  "Auth": {
    "CookieName": "CodigoActivo.Session",
    "ExpireHours": 8
  },
  "SessionCleanup": {
    "IntervalMinutes": 60
  },
  "AccountVerification": {
    "OtpLifetimeMinutes": 15,
    "ResendCooldownSeconds": 60
  },
  "PasswordReset": {
    "CodeLifetimeMinutes": 15,
    "ResendCooldownSeconds": 60
  },
  "PasswordLockout": {
    "MaxFailedAttempts": 5
  },
  "TwoFactor": {
    "ChallengeLifetimeMinutes": 10,
    "ResendCooldownSeconds": 60,
    "AuthenticatorSetupLifetimeMinutes": 15,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "Issuer": "Código Activo"
  },
  "ManualEmail": {
    "MaxRecipients": 500,
    "MaxAttachments": 10,
    "MaxAttachmentsBytes": 8388608
  },
  "EmailGuard": {
    "RecipientBurst": 20,
    "RecipientPerHour": 10,
    "RecipientPerDay": 50,
    "GlobalBurst": 1000,
    "GlobalPerHour": 1000,
    "GlobalCredentialReserve": 200,
    "MaxTrackedRecipients": 50000,
    "SweepIntervalMinutes": 5,
    "AlertIntervalMinutes": 15
  },
  "EmailQueue": {
    "Capacity": 1000,
    "Workers": 4,
    "ShutdownDrainSeconds": 20,
    "SendTimeoutSeconds": 60
  }
}
