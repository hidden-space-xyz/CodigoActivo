{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "MaxSizeBytes": 10485760
  },
  "Auth": {
    "CookieName": "CodigoActivo.Session",
    "ExpireHours": 8
  },
  "AccountVerification": {
    "OtpLifetimeMinutes": 15,
    "ResendCooldownSeconds": 60
  },
  "PasswordReset": {
    "CodeLifetimeMinutes": 15,
    "ResendCooldownSeconds": 60
  },
  "ManualEmail": {
    "MaxRecipients": 500,
    "MaxAttachments": 10,
    "MaxAttachmentsBytes": 8388608
  },
  "EmailGuard": {
    "RecipientBurst": 20,
    "RecipientPerHour": 10,
    "RecipientPerDay": 50,
    "GlobalBurst": 1000,
    "GlobalPerHour": 1000,
    "GlobalCredentialReserve": 200,
    "MaxTrackedRecipients": 50000,
    "SweepIntervalMinutes": 5,
    "AlertIntervalMinutes": 15
  }
}
