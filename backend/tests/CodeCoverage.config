<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Code Coverage settings for both test projects: measure only production code. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]CodigoActivo\.(API|Application|Composition|Domain|Infrastructure)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <!-- EF Core migrations are generated code, as declared in .editorconfig. -->
    <Sources>
      <Exclude>
        <Source>.*[\\/]Migrations[\\/].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <EnableStaticNativeInstrumentation>False</EnableStaticNativeInstrumentation>
    <EnableDynamicNativeInstrumentation>False</EnableDynamicNativeInstrumentation>
  </CodeCoverage>
</Configuration>
