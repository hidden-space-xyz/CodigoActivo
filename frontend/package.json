{
  "name": "codigo-activo-frontend",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./src --fail-on-warnings",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\" --max-warnings=0",
    "lint:styles:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run api:check && npm run build && npm run lint && npm run lint:fsd && npm run lint:styles && npm run lint:unused && npm run format:check",
    "api:generate": "orval --config ./orval.config.ts --fail-on-warnings",
    "api:check": "node ./scripts/check-api-client.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@tanstack/vue-query": "5.102.8",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "chart.js": "4.5.1",
    "element-plus": "2.14.5",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@types/node": "26.5.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.5.2",
    "eslint-plugin-vue": "10.11.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "jsonc-eslint-parser": "3.3.0",
    "knip": "6.35.1",
    "orval": "8.33.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "steiger": "0.6.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.19",
    "tsconfck": {
      "typescript": "$typescript"
    }
  }
}
