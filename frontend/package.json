{
  "name": "codigo-activo-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./src --fail-on-warnings",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\" --max-warnings=0",
    "lint:styles:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run api:check && npm run build && npm run test:coverage && npm run lint && npm run lint:fsd && npm run lint:styles && npm run lint:unused && npm run format:check",
    "api:generate": "orval --config ./orval.config.ts --fail-on-warnings",
    "api:check": "node ./scripts/check-api-client.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tanstack/vue-query": "5.107.1",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-highlight": "3.33.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/extension-text-align": "3.33.1",
    "@tiptap/extension-text-style": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/vue-3": "3.33.1",
    "chart.js": "4.6.1",
    "dayjs": "1.11.23",
    "element-plus": "2.14.8",
    "qrcode": "1.5.4",
    "signature_pad": "5.1.4",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-vue": "10.12.1",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "jsdom": "31.0.0",
    "jsonc-eslint-parser": "3.3.0",
    "knip": "6.45.0",
    "msw": "3.0.4",
    "orval": "8.47.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "steiger": "0.10.0",
    "stylelint": "18.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.1"
    },
    "fast-uri": "3.1.9",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "tsconfck": {
      "typescript": "$typescript"
    }
  }
}
