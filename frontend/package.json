{
  "name": "codigo-activo-frontend",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./src --fail-on-warnings",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\" --max-warnings=0",
    "lint:styles:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm run lint && npm run lint:fsd && npm run lint:styles && npm run lint:unused && npm run format:check",
    "api:generate": "orval --config ./orval.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2",
    "@tanstack/vue-query": "^5",
    "@tiptap/core": "^3",
    "@tiptap/extension-color": "^3",
    "@tiptap/extension-highlight": "^3",
    "@tiptap/extension-image": "^3",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-table": "^3",
    "@tiptap/extension-table-cell": "^3",
    "@tiptap/extension-table-header": "^3",
    "@tiptap/extension-table-row": "^3",
    "@tiptap/extension-text-align": "^3",
    "@tiptap/extension-text-style": "^3",
    "@tiptap/extension-underline": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/vue-3": "^3",
    "chart.js": "^4",
    "element-plus": "^2",
    "vue": "^3",
    "vue-i18n": "^11",
    "vue-router": "^5"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7",
    "@intlify/eslint-plugin-vue-i18n": "~4.5.1",
    "@types/node": "^26",
    "@vitejs/plugin-vue": "^6",
    "@vue/eslint-config-typescript": "^14",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^10",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "knip": "^6.35.1",
    "orval": "^8",
    "postcss-html": "^2.0.0",
    "prettier": "^3",
    "steiger": "^0.6",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "typescript": "^6",
    "vite": "^8",
    "vue-tsc": "^3"
  },
  "overrides": {
    "fast-uri": "^3",
    "js-yaml": "^4",
    "nanoid": "^3"
  }
}
