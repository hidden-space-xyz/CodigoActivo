POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=codigoactivo
POSTGRES_USER=codigoactivo
POSTGRES_PASSWORD=
DATA_PROTECTION_CERTIFICATE_PASSWORD=
PGDATA=/var/lib/postgresql/data/pgdata

ASPNETCORE_ENVIRONMENT=Production
APP_BASE_URL=https://example.org
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1

APP_TIMEZONE=Europe/Madrid
DEMO_MODE=false
AUTH_SAMESITE=Lax
AUTH_MAX_CONCURRENT_CREDENTIAL_REQUESTS=4
AUTH_MAX_QUEUED_CREDENTIAL_REQUESTS=128
FILE_STORAGE_ROOT=/app/files

ACCOUNT_VERIFICATION_REQUIRED=true
BOOTSTRAP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
